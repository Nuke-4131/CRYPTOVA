CRYPTOVA_ENV=development
# Use the Supabase Postgres connection string from Project Settings > Database.
# Keep the SQLite URL only when running the backend locally without Supabase.
CRYPTOVA_DATABASE_URL=sqlite:///./cryptova.db
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[database-password]@[pooler-host]:6543/postgres?sslmode=require
CRYPTOVA_STORAGE_DIR=./storage/encrypted_files
CRYPTOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CRYPTOVA_MASTER_KEY_B64=replace_with_32_byte_base64_key
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_KEY=replace_with_supabase_service_key
